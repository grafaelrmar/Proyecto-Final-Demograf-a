library(readxl)
library(dplyr)
# Cargamos los datos
ruta <- "C:/Users/Admin/Desktop/Rafa/Proyecto final demografía/Demography_9219/data/Datos tasas CDMX 2010 2019.xlsx"
df <- read_excel(ruta)
# Definimos la función para calcular las tasas
calcular_tasas <- function(df, poblacion_col, nacimientos_col) {
# Calculamos TEFE (fx = Nacimientos / Poblacion)
df <- df %>%
mutate(fx = !!sym(nacimientos_col) / !!sym(poblacion_col))
# TGF = 5 * suma(fx)
tgf <- 5 * sum(df$fx)
# TBR = TGF * proporcion_ninas (0.488 estándar demográfico)
tbr <- tgf * 0.488
return(list(TGF = tgf, TBR = tbr))
}
# Calculamos para 2010 y 2019
tasas_2010 <- calcular_tasas(df, "Pob2010", "Nac2010")
tasas_2019 <- calcular_tasas(df, "Pob2019", "Nac2019")
#print(paste("TGF 2010:", round(tasas_2010$TGF, 3)))
#print(paste("TBR 2010:", round(tasas_2010$TBR, 3)))
#print(paste("TGF 2019:", round(tasas_2019$TGF, 3)))
#print(paste("TBR 2019:", round(tasas_2019$TBR, 3)))
#2019
# (nacimientos / población)
fx_calculado_2019 <- (df$Nac2019 / df$Pob2019)
# Calculamos la proporción de niñas (0.488 es el estándar)
nacimientos_ninas_2019 <- fx_calculado_2019 * 0.488
# Cálculo final de TNR
tnr_2019 <- 5 * sum(nacimientos_ninas_2019*tabla_vida_mujeres$px[5:11])
#print(paste("TNR 2019:", round(tnr_final, 4)))
# Resultados
library(knitr)
library(kableExtra)
# Creamos el data.frame con los resultados
resumen_fecundidad <- data.frame(
Indicador = c("Tasa Global de Fecundidad (TGF)",
"Tasa Bruta de Reproducción (TBR)",
"Tasa Neta de Reproducción (TNR)"),
`2010` = c(tasas_2010$TGF, tasas_2010$TBR, NA),
`2019` = c(tasas_2019$TGF, tasas_2019$TBR, tnr_2019)
)
# Imprimimod la tabla
resumen_fecundidad %>%
kable(caption = "Indicadores de Fecundidad y Reproducción en la CDMX",
col.names = c("Indicador", "2010", "2019"),
digits = 4,
align = "l") %>%
kable_styling(bootstrap_options = c("striped", "hover", "condensed"))
# Cargamos las librerías necesarias
library(readxl)
library(dplyr)
library(ggplot2)
ruta_excel <- "C:/Users/Admin/Desktop/Rafa/Proyecto final demografía/Demography_9219/data/WPP2024_FERTILITY_RATES_DENMARK_MEXICO.xlsx"
# Añadimos los datos del excel
datos_dinamarca <- read_excel(ruta_excel, sheet = "Dinamarca", skip = 1) %>%
mutate(Territorio = "Dinamarca")
datos_mexico <- read_excel(ruta_excel, sheet = "Mexico", skip = 1) %>%
mutate(Territorio = "México") # Sugerencia: Añadido acento para coincidir con la gráfica
datos_cdmx <- read_excel(ruta_excel, sheet = "CDMX", skip = 1) %>%
mutate(Territorio = "Ciudad de México")
# Agregamos los grupos donde tiene sentido
grupos_validos <- c("15-19","20-24","25-29","30-34","35-39","40-44","45-49")
# Gráfica
datos_grafica <- bind_rows(datos_dinamarca, datos_mexico, datos_cdmx) %>%
filter(Edad %in% grupos_validos) %>%
mutate(Edad = factor(Edad, levels = grupos_validos))
ggplot(datos_grafica, aes(x = Edad, y = TEFE,
color = Territorio, group = Territorio)) +
geom_line(linewidth = 1.2) +
geom_point(size = 3) +
scale_color_manual(values = c(
"Ciudad de México" = "lightgreen",
"México"           = "red",       # Ahora coincide perfectamente con el mutate de arriba
"Dinamarca"        = "lightblue"
)) +
labs(
title    = "Tasas Específicas de Fecundidad (TEFE)",
subtitle = "Comparativa: CDMX, México y Dinamarca (2019)",
x        = "Grupo de edad de la madre",
y        = "Nacimientos por cada 1,000 mujeres",
color    = "Área geográfica",
caption  = "Fuente: ONU (WPP 2024) y CONAPO"
) +
theme_minimal(base_size = 13) +
theme(
legend.position  = "bottom",
plot.title       = element_text(face = "bold", hjust = 0.5),
plot.subtitle    = element_text(hjust = 0.5),
panel.grid.minor = element_blank()
)
