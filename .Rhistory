#--- 1. Establecer la ruta del archivo ---
ruta_archivo <- "C:/Users/Admin/Desktop/Rafa/Proyecto final demografía/Demography_9219/data/Datos_Tabla_Mortalidad_CDMX.xlsx"
#--- 2. Lectura y limpieza de datos ---
CDMX_mujeres <- read_excel(ruta_archivo,
sheet = "Tabla de Mortalidad Mujeres",
skip = 2) %>%
# Homologar los nombres de las columnas
rename(x = 1,
n = 2,
N = 3,
D = 4) %>%
# Transformar todas las columnas a variables numéricas
mutate(
x = as.numeric(x),
n = as.numeric(n),
N = as.numeric(N),
D = as.numeric(D),
# Cálculo de las tasas de mortalidad (se guarda como 'mx' en minúsculas)
mx = D/N
)
#--- 3. Función de tablas de vida abreviadas  ---
lt_abreviada <- function(x, n, mx, sex = "f", IMR = NA){
m <- length(x)
ax <- n / 2
# Ajustes Coale-Demeny para edades 0-1
if(sex == "m"){
ax[1] <- ifelse(mx[1] >= 0.107, 0.330, 0.045 + 2.684 * mx[1])
} else {
ax[1] <- ifelse(mx[1] >= 0.107, 0.350, 0.053 + 2.800 * mx[1])
}
# Ajustes Coale-Demeny para edades 1-4
if(sex == "m"){
ax[2] <- ifelse(mx[1] >= 0.107, 1.352, 1.651 - 2.816 * mx[1])
} else {
ax[2] <- ifelse(mx[1] >= 0.107, 1.361, 1.522 - 1.518 * mx[1])
}
# Probabilidades de muerte
qx <- (n * mx) / (1 + (n - ax) * mx)
qx[m] <- 1
# Probabilidades de sobrevivencia
px <- 1 - qx
# lx
lx <- 100000 * cumprod(c(1, px[-m]))
# dx
dx <- c(-diff(lx), lx[m])
# Lx
Lx <- (n * c(lx[-1],0)) + (ax * dx)
Lx[m] <- lx[m]/mx[m]
# Tx
Tx <- rev(cumsum(rev(Lx)))
# ex
ex <- Tx / lx
return(data.table(x, n, mx, ax, qx, px, lx, dx, Lx, Tx, ex))
}
#--- 4. Aplica función a tus datos ---
tabla_vida_mujeres <- lt_abreviada(
x   = CDMX_mujeres$x,
n   = CDMX_mujeres$n,
mx  = CDMX_mujeres$mx,
sex = "f"
)
#--- 5. Visualizar resultado ---
#head(tabla_vida_mujeres)
tabla_vida_mujeres %>%
kable(format = "latex", booktabs = TRUE, caption = "Tabla de Vida de Mujeres") %>%
kable_styling(latex_options = c("striped", "scale_down"))
#Gráfica mx en escala lineal
ggplot(tabla_vida_mujeres, aes(x=x, y=mx)) + geom_line(color = "red") +
theme_minimal() + labs(title = "Tasa de mortalidad - Escala lineal. Mujeres CDMX",
x = "Edad",
y = "mx")
# Gráfica de mx a escala logarítmica
ggplot(tabla_vida_mujeres, aes(x = x, y = mx)) +
geom_line(color = "blue") +
scale_y_log10() +
theme_minimal() +
labs(title = "Tasa de mortalidad - Escala log. Mujeres CDMX", x = "Edad", y = "mx log")
#Tabla de mortalidad Hombres
CDMX_hombres <- read_excel(ruta_archivo,
