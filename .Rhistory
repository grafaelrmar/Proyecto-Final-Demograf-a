# 2. Instalar paquetes
#install.packages("lubridate", dependencies = T)
#install.packages("dplyr")
library(data.table)
library(lubridate)
library(kableExtra)
library(ggplot2)
library(tidyverse)
library(magrittr)
library(dplyr)
# 3. Descargar tablas de datos
#pop <- fread("https://repodatos.atdt.gob.mx/CONAPO/proyecciones/00#_Pob_Mitad_1950_2070.csv")
pop <- fread("data/00_Pob_Mitad_1950_2070.csv")
# 4. Exploración de la tabla de población
table(pop$ENTIDAD)
table(pop$CVE_GEO)
table(pop$ANIO)
names(pop)
sum(pop$POBLACION)
#5. Filtramos tabla de datos para nuestra entidad
pop_cdmx <- pop[
ENTIDAD == "Ciudad de México" &
ANIO == 2026,
.(SEXO, EDAD, POBLACION)
]
# 6. Instalar y cargar ggplot2 si no lo tienes
#install.packages("ggplot2")
{r, echo=FALSE}
# Pongo fig.height=, fig.width=, adentro de {} para modificar tamaño de graficas
# 7. Preparar los datos para la pirámide
pop_cdmx <- pop[ENTIDAD == "Ciudad de México" & ANIO == 2026, .(SEXO, EDAD, POBLACION)]
# 8. Convertir población masculina a valores negativos para graficar
pop_cdmx[, POBLACION := ifelse(SEXO == "Hombres", -POBLACION, POBLACION)]
# 9. Graficar pirámide poblacional
ggplot(pop_cdmx, aes(x = EDAD, y = POBLACION, fill = SEXO)) +
geom_bar(stat = "identity", width = 1) +
coord_flip() +
scale_y_continuous(labels = abs) +
labs(title = "Pirámide poblacional de la Ciudad de México, 2026",
x = "Edad",
y = "Población") +
theme_minimal() +
scale_fill_manual(values = c("Hombres" = "steelblue", "Mujeres" = "salmon"))
pop_cdmx_2070 <- pop[ENTIDAD == "Ciudad de México" & ANIO == 2070, .(SEXO, EDAD, POBLACION)]
# 8. Convertir población masculina a valores negativos para graficar
pop_cdmx_2070[, POBLACION := ifelse(SEXO == "Hombres", -POBLACION, POBLACION)]
# 9. Graficar pirámide poblacional
ggplot(pop_cdmx_2070, aes(x = EDAD, y = POBLACION, fill = SEXO)) +
geom_bar(stat = "identity", width = 1) +
coord_flip() +
scale_y_continuous(labels = abs) +
labs(title = "Pirámide poblacional de la Ciudad de México, 2070",
x = "Edad",
y = "Población") +
theme_minimal() +
scale_fill_manual(values = c("Hombres" = "steelblue", "Mujeres" = "salmon"))
