library(ggplot2)
library(dplyr)
library(tidyr)
library(patchwork)
# --- Función auxiliar para graficar en log ---
plot_log <- function(data, col, titulo, subtitulo = "", color_linea = "blue") {
ggplot(data, aes(x = x, y = .data[[col]])) +
geom_line(color = color_linea, linewidth = 0.9) +
geom_point(color = color_linea, size = 1.4, alpha = 0.7) +
scale_y_log10(labels = scales::label_scientific()) +
scale_x_continuous(breaks = seq(0, max(data$x), by = 10)) +
theme_minimal(base_size = 12) +
theme(
plot.title    = element_text(face = "bold", size = 13),
plot.subtitle = element_text(color = "gray", size = 10),
panel.grid.minor = element_blank()
) +
labs(title = titulo, subtitle = subtitulo, x = "Edad (x)", y = paste0("log(", col, ")"))
}
apv_m <- plot_log(tabla_vida_mujeres, "ax",
"Años persona vividos (nax) — Mujeres CDMX", color_linea = "pink")
print(apv_m)
apv_h <- plot_log(tabla_vida_hombres, "ax",
"Años persona vividos (nax) — Hombres CDMX", color_linea = "blue")
print(apv_h)
