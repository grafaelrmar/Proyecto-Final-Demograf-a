apv_m <- plot_log(tabla_vida_mujeres, "ax", "", color_linea = "pink") + labs(title = "Mujeres")
apv_h <- plot_log(tabla_vida_hombres, "ax", "", color_linea = "blue") + labs(title = "Hombres")
# Combinamos las gráficas usando patchwork
comparativa_apv <- (apv_m + apv_h) +
plot_layout(ncol = 2) +
plot_annotation(
title = "Años persona vividos (nax)",
subtitle = "Comparativa por sexo en CDMX",
theme = theme(plot.title = element_text(size = 14, face = "bold"))
)
# Imprimimos
