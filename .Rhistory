#--- 1. Establecer la ruta del archivo ---
ruta_archivo <- "C:/Users/Admin/Desktop/Rafa/Proyecto final demografía/Demography_9219/data/Datos_Tabla_Mortalidad_CDMX.xlsx"
#--- 2. Lectura y limpieza de datos ---
CDMX_mujeres <- read_excel(ruta_archivo,
sheet = "Tabla de Mortalidad Mujeres",
skip = 3) %>%
# Homologar los nombres de las columnas
rename(x = 1,
n = 2,
N = 3,
D = 4) %>%
# Transformar todas las columnas a variables numéricas
mutate(
x = as.numeric(x),
n = as.numeric(n),
N = as.numeric(N),
D = as.numeric(D),
# Cálculo de las tasas de mortalidad (se guarda como 'mx' en minúsculas)
mx = D/N
)
#--- 3. Función de tablas de vida abreviadas  ---
lt_abreviada <- function(x, n, mx, sex = "f", IMR = NA){
m <- length(x)
ax <- n / 2
# Ajustes Coale-Demeny para edades 0-1
if(sex == "m"){
ax[1] <- ifelse(mx[1] >= 0.107, 0.330, 0.045 + 2.684 * mx[1])
} else {
ax[1] <- ifelse(mx[1] >= 0.107, 0.350, 0.053 + 2.800 * mx[1])
}
# Ajustes Coale-Demeny para edades 1-4
if(sex == "m"){
ax[2] <- ifelse(mx[1] >= 0.107, 1.352, 1.651 - 2.816 * mx[1])
} else {
ax[2] <- ifelse(mx[1] >= 0.107, 1.361, 1.522 - 1.518 * mx[1])
}
# Probabilidades de muerte
qx <- (n * mx) / (1 + (n - ax) * mx)
qx[m] <- 1
# Probabilidades de sobrevivencia
px <- 1 - qx
# lx
lx <- 100000 * cumprod(c(1, px[-m]))
# dx
dx <- c(-diff(lx), lx[m])
# Lx
Lx <- (n * c(lx[-1],0)) + (ax * dx)
Lx[m] <- lx[m]/mx[m]
# Tx
Tx <- rev(cumsum(rev(Lx)))
# ex
ex <- Tx / lx
return(data.table(x, n, mx, ax, qx, px, lx, dx, Lx, Tx, ex))
}
#--- 4. Aplica función a tus datos ---
tabla_vida_mujeres <- lt_abreviada(
x   = CDMX_mujeres$x,
n   = CDMX_mujeres$n,
mx  = CDMX_mujeres$mx,
sex = "f"
)
#--- 5. Visualizar resultado ---
head(tabla_vida_mujeres)
#Gráfica mx en escala lineal
ggplot(tabla_vida_mujeres, aes(x=x, y=mx)) + geom_line(color = "red") +
theme_minimal() + labs(title = "Tasa de mortalidad - Escala lineal. Mujeres CDMX",
x = "Edad",
y = "mx")
# Gráfica de mx a escala logarítmica
ggplot(tabla_vida_mujeres, aes(x = x, y = mx)) +
geom_line(color = "blue") +
scale_y_log10() +
theme_minimal() +
labs(title = "Tasa de mortalidad - Escala log. Mujeres CDMX", x = "Edad", y = "mx log")
#Tabla de mortalidad Hombres
CDMX_hombres <- read_excel(ruta_archivo,
sheet = "Tabla de Mortalidad Hombres ",
skip = 3) %>%
# Homologar los nombres de las columnas
rename(x = 1,
n = 2,
N = 3,
D = 4) %>%
# Transformar todas las columnas a variables numéricas
mutate(
x = as.numeric(x),
n = as.numeric(n),
N = as.numeric(N),
D = as.numeric(D),
mx = D/N
)
tabla_vida_hombres <- lt_abreviada(
x   = CDMX_hombres$x,
n   = CDMX_hombres$n,
mx  = CDMX_hombres$mx,
sex = "m"
)
head(tabla_vida_hombres)
#Gráfica mx en escala lineal
ggplot(tabla_vida_hombres, aes(x=x, y=mx)) + geom_line(color = "red") +
theme_minimal() + labs(title = "Tasa de mortalidad - Escala lineal. Hombres CDMX",
x = "Edad",
y = "mx")
# Gráfica de mx a escala logarítmica
ggplot(tabla_vida_hombres, aes(x = x, y = mx)) +
geom_line(color = "blue") +
scale_y_log10() +
theme_minimal() +
labs(title = "Tasa de mortalidad - Escala log. Hombres CDMX", x = "Edad", y = "mx log")
#Esperanza de vida al nacer
e0_mujeres <- data.table(
Sexo = "Mujeres",
Esperanza_Vida_al_Nacer_2019 = tabla_vida_mujeres$ex[1]
)
e0_hombres <- data.table(
Sexo = "Hombres",
Esperanza_Vida_al_Nacer_2019 = tabla_vida_hombres$ex[1]
)
# Combinamos ambos sexos en un solo cuadro unificado
cuadro_esperanza_vida <- rbind(e0_mujeres, e0_hombres)
# Redondeamos a dos decimales para una presentación limpia
cuadro_esperanza_vida[, Esperanza_Vida_al_Nacer_2019 := round(Esperanza_Vida_al_Nacer_2019, 2)]
#Visualizamos el cuadro
print("=== CUADRO RESUMEN: ESPERANZA DE VIDA AL NACER ===")
print(cuadro_esperanza_vida)
#--- Carga de librerias que vamos a usar---
library(ggplot2)
library(dplyr)
library(tidyr)
# --- Función auxiliar para graficar en log ---
plot_log <- function(data, col, titulo, subtitulo = "", color_linea = "blue") {
ggplot(data, aes(x = x, y = .data[[col]])) +
geom_line(color = color_linea, linewidth = 0.9) +
geom_point(color = color_linea, size = 1.4, alpha = 0.7) +
scale_y_log10(labels = scales::label_scientific()) +
scale_x_continuous(breaks = seq(0, max(data$x), by = 10)) +
theme_minimal(base_size = 12) +
theme(
plot.title    = element_text(face = "bold", size = 13),
plot.subtitle = element_text(color = "gray", size = 10),
panel.grid.minor = element_blank()
) +
labs(title = titulo, subtitle = subtitulo, x = "Edad (x)", y = paste0("log(", col, ")"))
}
apv_m <- plot_log(tabla_vida_mujeres, "ax",
"Años persona vividos por fallecidos (nax) — Mujeres CDMX", color_linea = "pink")
print(apv_m)
apv_h <- plot_log(tabla_vida_hombres, "ax",
"Años persona vividos por fallecidos (nax) — Hombres CDMX", color_linea = "blue")
print(apv_h)
comparativa_apv  <- apv_m  + apv_h  + plot_annotation(title = "nax — Comparativa por sexo")
