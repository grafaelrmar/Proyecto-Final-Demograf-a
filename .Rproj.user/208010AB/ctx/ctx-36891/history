weight_mean <- function(x,
w=rep(1/length(x),
length(x))){
x_mean <- sum(x*w)/sum(w)
return(x_mean)
}
# Ejemplo
weight_mean(c(10,40), c(0.3, 0.7)) #Ejemplo con pesos
weight_mean(c(10,40)) #Ejemplo sin pesos
install.packages("lubridate", dependencies = T)
#library(data.table)
library(lubridate)
# 3. Crecimiento exponencial ----
expo <- function(N_0, N_T, t_0, t_T, t){
dt <- decimal_date(as.Date(t_T)) - decimal_date(as.Date(t_0))
r <- log(N_T/N_0)/dt
h <- t - decimal_date(as.Date(t_0))
N_h <- N_0 * exp(r*h)
return(N_h) }
cre_exp <- expo( N_0=112336538, N_T=126014024, t_0="2010-06-25", t_T="2020-03-15", t=seq(2020.5, 2100.5, 1) )
# Gráfica
data.frame(Año = c(decimal_date(as.Date("2010-06-25")), decimal_date(as.Date("2020-03-15")), seq(2020.5, 2100.5, 1)), N_t = c(112336538, 126014024, cre_exp)) %>% ggplot(aes(Año, N_t)) + geom_line() + geom_point()
