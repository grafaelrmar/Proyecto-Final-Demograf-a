weighted_mean <- function(x, w=1/length(x)){
x_mean <- (x*w)/sum(w)
return(x_mean)
}
weight_mean(1:10)
weight_mean <- function(x, w=1/length(x)){
x_mean <- (x*w)/sum(w)
return(x_mean)
}
weight_mean(1:10)
weight_mean <- function(x, w=1/length(x)){
x_mean <- sum(x*w)/sum(w)
return(x_mean)
}
weight_mean(1:10)
